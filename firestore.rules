rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public READ access to villages directory so users can select village on language screen
    match /villages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public READ access to all service categories
    match /construction/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /labour/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /transport/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /mandi/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /health/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /family/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /news/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // General fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
