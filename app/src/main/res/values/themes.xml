<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AapanGav" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Explicitly set window background to white to prevent black flash during recreation -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.AapanGav</item>
    </style>
</resources>